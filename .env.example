# Copy to .env.dev for `npm run dev` (it is copied to .env.local). See the Configuration section of README.md.
NEXT_PUBLIC_SERVER_MANAGER_SERVICE_DOMAIN="http://localhost:3000"
NEXT_PUBLIC_GLOOMHAVEN_COMPANION_SERVICE_DOMAIN="http://localhost:7575"
NEXT_PUBLIC_GLOOMHAVEN_COMPANION_WEBSOCKETS_URL="ws://localhost:8080/ws"
NEXT_PUBLIC_WEBSITE_DOMAIN="http://localhost:3100"
NEXT_PUBLIC_GAME_SERVER_HOST="localhost"
NEXT_PUBLIC_AUTH0_DOMAIN="YOUR_TENANT.us.auth0.com"
NEXT_PUBLIC_AUTH0_CLIENT_ID="YOUR_AUTH0_APPLICATION_CLIENT_ID"
NEXT_PUBLIC_AUTH0_AUDIENCE="YOUR_AUTH0_API_IDENTIFIER"
NEXT_PUBLIC_AUTH0_SCOPES="server-manager:admin gloomhaven-companion:admin server-manager:public gloomhaven-companion:public"
